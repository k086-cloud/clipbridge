<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 与 Xcode 生成的 Info.plist 合并（GENERATE_INFOPLIST_FILE=YES + INFOPLIST_FILE）。这里只放生成器给不了的键。 -->
	<key>AppIdentifierPrefix</key>
	<string>$(AppIdentifierPrefix)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>ClipBridge 需要连接同一局域网里的电脑，才能同步剪贴板。</string>
	<key>NSCameraUsageDescription</key>
	<string>用于扫描电脑上显示的配对二维码。</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.charleschen.ClipBridge</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>clipbridge</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
